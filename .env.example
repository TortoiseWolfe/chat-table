# Copy this file to .env and fill in the first four lines. Every other line is optional.

# Your Twitch application (https://dev.twitch.tv/console/apps): client type Confidential.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# The login of the channel the game runs on, and the login of the bot's own Twitch account.
TWITCH_BROADCASTER_LOGIN=
TWITCH_BOT_LOGIN=

# Narration (optional): any OpenAI-compatible endpoint. Leave these empty to use the pack's
# pre-written lines. NARRATOR_URL is the address up to and including /v1.
NARRATOR_URL=
NARRATOR_MODEL=
NARRATOR_API_KEY=
# Milliseconds to wait for the narrator before using the pre-written line (default 8000).
NARRATOR_TIMEOUT_MS=8000

# Where the game saves (default /data, the volume in compose.yaml).
DATA_DIR=/data
# The content pack folder (default /app/packs/frontier, the pack in the image).
PACK=/app/packs/frontier
# The port for the overlay and the admin dock (default 8787; compose.yaml publishes it on 127.0.0.1).
HTTP_PORT=8787

# Seconds each round waits for players to declare their action (default 60).
DECLARE_SECONDS=60
# What a roll of all ones does: complication, drop-highest or none (default drop-highest).
SPECIAL_ONE=drop-highest
# The most Character Points a player may spend on one roll (default 2).
CP_PER_ROLL_MAX=2

# AI-driven seats (optional). The path of a seats file (see docs/ai-seats.example.json); leave empty
# for human and bot seats only. The file names the key files; no key goes in this file.
AI_SEATS_FILE=
# Seconds each AI answer is held back so a table of models reads like people (default 0).
AI_PACE_SECONDS=0

# A private, game-master-only adventure module (optional). An absolute path to a folder OUTSIDE the
# repo, shaped like packs/module-template. Unset means no module; a path inside the repo is refused.
PRIVATE_MODULE_DIR=
