{
  "name": "chat-table",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=default --reporter=json --outputFile=out/vitest.json && node scripts/check-no-skips.mjs out/vitest.json",
    "lint": "eslint . && markdownlint-cli2",
    "guard": "tsx src/guard/cli.ts .",
    "sim": "tsx src/sim/cli.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "markdownlint-cli2": "0.24.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
